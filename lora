#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
python="${LORA_PIPELINE_PYTHON:-$root/.conda/envs/lora-pipeline/bin/python}"
if [[ ! -x "$python" ]]; then
  python="${PYTHON:-python3}"
fi
export LORA_PIPELINE_ROOT="${LORA_PIPELINE_ROOT:-$root}"
if [[ "$#" -eq 0 ]]; then
  exec "$python" -m pipeline.interactive
fi
if [[ "$1" == "web" ]]; then
  shift
  exec "$python" -m pipeline.web_app "$@"
fi
exec "$python" -m pipeline.cli "$@"
