#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
python="${LORA_PIPELINE_PYTHON:-$root/.conda/envs/lora-pipeline/bin/python}"
if [[ ! -x "$python" ]]; then
  python="${PYTHON:-python3}"
fi
export LORA_PIPELINE_ROOT="${LORA_PIPELINE_ROOT:-$root}"
exec "$python" -m pipeline.cli "$@"
